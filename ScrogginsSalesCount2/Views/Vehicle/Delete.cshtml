@model Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<h2>Confirm Deletion</h2>
<h3>Are you SURE you want to delete this @Model.Year @Model.Make @Model.Model (@Model.Stock)?</h3>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="VehicleId" />

    <button type="submit" class="btn btn-dark mt-4">Delete</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-dark mt-4">X</a>
</form>
