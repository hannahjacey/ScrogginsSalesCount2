@model Vehicle
@{
    string title = ViewBag.Action + " Sold Vehicle";
    ViewData["Title"] = title;
}
 
<h2>@ViewBag.Title</h2>

<form asp-action="Save" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Stock" class="form-label">Stock #</label>
        <input asp-for="Stock" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label">Year</label>
        <input asp-for="Year" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Make" class="form-label">Make</label>
        <input asp-for="Make" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label">Model</label>
        <input asp-for="Model" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CustomerName" class="form-label">Customer</label>
        <input asp-for="CustomerName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="SalesPersonId">Sales Person</label>
        <select asp-for="SalesPersonId" class="form-control">
            <option value="">Select a Sales Person</option>
            @foreach (SalesPerson s in ViewBag.Sale)
            {
                <option value="@s.SalesPersonId">@s.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="SaleDate" class="form-label">Sale Date</label>
        <input asp-for="SaleDate" class="form-control" />
    </div>

    <input type="hidden" asp-for="VehicleId" />

    <button type="submit" class="btn btn-dark mt-4">Save</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-dark mt-4">X</a>
</form>
