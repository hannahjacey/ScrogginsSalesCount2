@model List<Vehicle>
@{
    ViewData["Title"] = "Sold Vehicles";
}

<div class="container-fluid mb-3">
    <div class="row">
        <div class="col-6">
            <a asp-controller="Vehicle" asp-action="Add" class="btn btn-outline-dark">Add Sold Vehicle</a>
        </div>
        <div class="col-6">
            <div class="dropdown">
                <button class="btn btn-outline-dark dropdown-toggle me-2" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                    Choose a Month
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">

                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Index">All</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Jan">January</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Feb">February</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Mar">March</a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Apr">April</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="May">May</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Jun">June</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Jul">July</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Aug">August</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Sep">September</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Oct">October</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Nov">November</a>
                    </li>
                    <li>
                        <a class="dropdown-item disabled" asp-controller="Home" asp-action="Dec">December</a>
                    </li>

                </ul>
            </div>
        </div>
    </div>
</div>

<table class="table table-bordered border-dark table-striped">
    <thead>
        <tr>
            <th>Stock#</th>
            <th>Vehicle</th>
            <th>Customer</th>
            <th>Sales Person</th>
            <th>Date Sold</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var v in Model)
        {

            <tr>
                <td>@v.Stock</td>
                <td>@v.Year @v.Make @v.Model</td>
                <td>@v.CustomerName</td>
                <td>@v.SalesPerson.Name</td>
                <td>@v.SaleDate</td>

                <td>
                    <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@v.VehicleId">Edit</a>
                    <a asp-controller="Vehicle" asp-action="Delete" asp-route-id="@v.VehicleId">Delete</a>
                </td>
            </tr>
            
        }
   </tbody>

</table>
